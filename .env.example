# Copy to .env. Localhost works with microphone permissions without TLS.
HOST=127.0.0.1
PORT=8787
MAX_PARTICIPANTS=8
# Optional persistent room data location. Default: ./data/roomtone.json
# ROOMTONE_DATA=./data/roomtone.json
# Optional shared password. Enter the same value in the app Settings.
ROOM_PASSWORD=
# For remote access: use a valid HTTPS certificate or a TLS reverse proxy.
# HOST=0.0.0.0
# ROOMTONE_CERT=C:/certificates/fullchain.pem
# ROOMTONE_KEY=C:/certificates/private.key
# When using a reverse proxy, set its public HTTPS origin, without a trailing slash.
# PUBLIC_ORIGIN=https://practice.example.com
# Use relay to test TURN-only connectivity; all permits direct or relay connections.
ICE_TRANSPORT_POLICY=all
# Supply your own TURN relay for restrictive networks. Never commit real credentials.
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"temporary-user","credential":"temporary-password"}]
